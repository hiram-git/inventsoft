---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { store } from '../../lib/store';

let error = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const almacenId = formData.get('almacenId')?.toString() ?? '';
  const almacen = await store.getAlmacen(almacenId);

  if (!almacen) {
    error = 'Seleccione un almacén válido.';
  } else {
    const proveedorNombre = formData.get('proveedorNombre')?.toString() ?? '';
    if (!proveedorNombre) {
      error = 'Ingrese el nombre del proveedor.';
    } else {
      const itemsJson = formData.get('items_json')?.toString() ?? '[]';
      let items;
      try { items = JSON.parse(itemsJson); } catch { items = []; }

      if (items.length === 0) {
        error = 'Agregue al menos un producto.';
      } else {
        const impuestoId = formData.get('impuestoId')?.toString() ?? '';
        let impuestoPorcentaje = 16;
        let impuestoNombre = 'IVA';
        if (impuestoId) {
          const imp = (await store.getImpuestos()).find(i => String(i.id) === impuestoId);
          if (imp) { impuestoPorcentaje = imp.porcentaje; impuestoNombre = imp.nombre; }
        }
        const subtotal = items.reduce((sum: number, i: { subtotal: number }) => sum + i.subtotal, 0);
        const iva = subtotal * (impuestoPorcentaje / 100);
        const total = subtotal + iva;

        const proveedorId = formData.get('proveedorId')?.toString() ?? '';
        await store.createCompra({
          proveedorNombre,
          proveedorId: proveedorId || undefined,
          almacenId,
          almacenNombre: almacen.nombre,
          items,
          subtotal,
          iva,
          total,
          fecha: new Date().toISOString().split('T')[0],
          impuestoId: impuestoId || undefined,
          impuestoNombre,
          impuestoPorcentaje,
        });

        return Astro.redirect('/compras');
      }
    }
  }
}

const [almacenes, allProductos, impuestos, impuestoDefault, proveedores] = await Promise.all([
  store.getAlmacenes(),
  store.getProductos(),
  store.getImpuestos(),
  store.getImpuestoDefault(),
  store.getProveedores(),
]);
const productos = allProductos.filter(p => p.activo);
const moneda = Astro.locals.moneda ?? { simbolo: '$' };
---

<AdminLayout title="Nueva Compra">
  <div class="page-header">
    <h1>Nueva Compra</h1>
    <a href="/compras" class="btn btn-secondary">
      <span class="material-icons-round">arrow_back</span> Volver
    </a>
  </div>

  {error && <div class="alert alert-error">{error}</div>}

  <form method="POST" id="compraForm">
    <input type="hidden" name="items_json" id="itemsJson" value="[]" />
    <input type="hidden" name="proveedorId" id="hiddenProveedorId" />

    <div class="card" style="margin-bottom:16px">
      <h2 style="font-size:1.1rem;margin-bottom:16px">Datos de la Compra</h2>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px">
        <div class="form-group">
          <label>Proveedor</label>
          {proveedores.filter(p => p.activo).length > 0 ? (
            <select name="proveedorId" id="proveedorSelect" class="form-control"
              onchange="syncProveedorNombre(this)">
              <option value="">— Proveedor eventual (sin registro) —</option>
              {proveedores.filter(p => p.activo).map(p => (
                <option value={p.id} data-nombre={p.nombre}>{p.nombre}</option>
              ))}
            </select>
          ) : null}
          <input type="text" name="proveedorNombre" id="proveedorNombreInput" class="form-control"
            placeholder="Nombre del proveedor" required
            style={proveedores.filter(p => p.activo).length > 0 ? "margin-top:6px" : ""}
          />
          {proveedores.filter(p => p.activo).length > 0 && (
            <span style="font-size:0.75rem;color:var(--text-muted)">
              Si seleccionas un proveedor del listado, el nombre se completa automáticamente. De lo contrario, escríbelo.
            </span>
          )}
        </div>
        <div class="form-group">
          <label>Almacén de destino</label>
          <select name="almacenId" class="form-control" required>
            <option value="">Seleccionar almacén...</option>
            {almacenes.filter(a => a.activo).map(a => (
              <option value={a.id}>{a.nombre}</option>
            ))}
          </select>
        </div>
        <div class="form-group">
          <label>Impuesto</label>
          <select name="impuestoId" id="impuestoSelect" class="form-control"
            onchange="updateImpuesto(this.value)">
            <option value="">Sin impuesto (0%)</option>
            {impuestos.filter(i => i.activo).map(i => (
              <option value={i.id}
                data-pct={i.porcentaje}
                data-nombre={i.nombre}
                selected={String(i.id) === String(impuestoDefault?.id)}>
                {i.nombre} ({i.porcentaje}%)
              </option>
            ))}
          </select>
        </div>
      </div>
    </div>

    <div class="card" style="margin-bottom:16px">
      <h2 style="font-size:1.1rem;margin-bottom:16px">Productos a Comprar</h2>

      <div style="display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:8px;margin-bottom:16px;align-items:end">
        <div class="form-group" style="margin-bottom:0">
          <label>Producto</label>
          <select id="selProducto" class="form-control">
            <option value="">Seleccionar...</option>
            {productos.map(p => (
              <option value={p.id} data-nombre={p.nombre} data-precio={p.precio}>
                {p.nombre} — ${p.precio.toLocaleString('es-MX', { minimumFractionDigits: 2 })}
              </option>
            ))}
          </select>
        </div>
        <div class="form-group" style="margin-bottom:0">
          <label>Cantidad</label>
          <input type="number" id="cantidad" class="form-control" min="1" value="1" />
        </div>
        <div class="form-group" style="margin-bottom:0">
          <label>Precio Unitario</label>
          <input type="number" id="precioUnitario" class="form-control" step="0.01" min="0" placeholder="0.00" />
        </div>
        <button type="button" class="btn btn-success" onclick="addItem()" style="height:38px">
          <span class="material-icons-round" style="font-size:18px">add</span> Agregar
        </button>
      </div>

      <table id="itemsTable">
        <thead>
          <tr>
            <th>Producto</th>
            <th>P. Unitario</th>
            <th>Cantidad</th>
            <th>Subtotal</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="itemsBody">
          <tr id="emptyRow">
            <td colspan="5" style="text-align:center;color:var(--text-muted)">No se han agregado productos.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="card">
      <div class="totals">
        <div class="total-row">
          <span>Subtotal:</span>
          <span id="subtotalDisplay">{moneda.simbolo}0.00</span>
        </div>
        <div class="total-row">
          <span id="ivaLabel">Impuesto ({impuestoDefault ? impuestoDefault.porcentaje + '%' : '0%'}):</span>
          <span id="ivaDisplay">{moneda.simbolo}0.00</span>
        </div>
        <div class="total-row total-final">
          <span>Total:</span>
          <span id="totalDisplay">$0.00</span>
        </div>
      </div>
      <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:20px">
        <a href="/compras" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">
          <span class="material-icons-round" style="font-size:18px">save</span> Guardar Compra
        </button>
      </div>
    </div>
  </form>
</AdminLayout>

<style>
  .totals { max-width: 300px; margin-left: auto; }
  .total-row { display: flex; justify-content: space-between; padding: 8px 0; font-size: 0.95rem; }
  .total-row + .total-row { border-top: 1px solid var(--border); }
  .total-final { font-size: 1.15rem; font-weight: 700; color: var(--primary); }
</style>

<script is:inline>
  function syncProveedorNombre(sel) {
    var opt = sel.options[sel.selectedIndex];
    var nameInput = document.getElementById('proveedorNombreInput');
    var hiddenId = document.getElementById('hiddenProveedorId');
    if (sel.value && opt.dataset.nombre) {
      nameInput.value = opt.dataset.nombre;
      hiddenId.value = sel.value;
    } else {
      nameInput.value = '';
      hiddenId.value = '';
    }
  }

  let items = [];
  var __impuestoPct = 0;
  var __m = window.__moneda || { simbolo: '$' };

  (function() {
    var sel = document.getElementById('impuestoSelect');
    if (sel && sel.value) {
      var opt = sel.options[sel.selectedIndex];
      __impuestoPct = parseFloat(opt.dataset.pct || '0');
    }
  })();

  function updateImpuesto(id) {
    var sel = document.getElementById('impuestoSelect');
    if (!id) {
      __impuestoPct = 0;
      document.getElementById('ivaLabel').textContent = 'Impuesto (0%):';
    } else {
      var opt = sel.options[sel.selectedIndex];
      __impuestoPct = parseFloat(opt.dataset.pct || '0');
      document.getElementById('ivaLabel').textContent = opt.dataset.nombre + ' (' + __impuestoPct + '%):';
    }
    renderItems();
  }

  document.getElementById('selProducto').addEventListener('change', function() {
    const opt = this.options[this.selectedIndex];
    if (opt.dataset.precio) {
      document.getElementById('precioUnitario').value = parseFloat(opt.dataset.precio).toFixed(2);
    }
  });

  function addItem() {
    const sel = document.getElementById('selProducto');
    const cantInput = document.getElementById('cantidad');
    const precioInput = document.getElementById('precioUnitario');
    const opt = sel.options[sel.selectedIndex];

    if (!sel.value) return alert('Seleccione un producto.');
    const cantidad = parseInt(cantInput.value) || 1;
    const precioUnitario = parseFloat(precioInput.value) || 0;
    if (cantidad <= 0) return alert('La cantidad debe ser mayor a 0.');
    if (precioUnitario <= 0) return alert('Ingrese el precio unitario.');

    const productoId = sel.value;
    const productoNombre = opt.dataset.nombre;

    const existing = items.find(i => i.productoId === productoId);
    if (existing) {
      existing.cantidad += cantidad;
      existing.subtotal = existing.cantidad * existing.precioUnitario;
    } else {
      items.push({ productoId, productoNombre, cantidad, precioUnitario, subtotal: cantidad * precioUnitario });
    }

    sel.value = '';
    cantInput.value = '1';
    precioInput.value = '';
    renderItems();
  }

  function removeItem(index) {
    items.splice(index, 1);
    renderItems();
  }

  function renderItems() {
    const tbody = document.getElementById('itemsBody');
    const fmt = (n) => __m.simbolo + n.toLocaleString('es-MX', { minimumFractionDigits: 2 });

    if (items.length === 0) {
      tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:var(--text-muted)">No se han agregado productos.</td></tr>';
    } else {
      tbody.innerHTML = items.map((item, i) => `
        <tr>
          <td>${item.productoNombre}</td>
          <td>${fmt(item.precioUnitario)}</td>
          <td>${item.cantidad}</td>
          <td><strong>${fmt(item.subtotal)}</strong></td>
          <td>
            <button type="button" class="btn btn-danger btn-sm" onclick="removeItem(${i})">
              <span class="material-icons-round" style="font-size:16px">close</span>
            </button>
          </td>
        </tr>
      `).join('');
    }

    const subtotal = items.reduce((s, i) => s + i.subtotal, 0);
    const iva = subtotal * (__impuestoPct / 100);
    const total = subtotal + iva;

    document.getElementById('subtotalDisplay').textContent = fmt(subtotal);
    document.getElementById('ivaDisplay').textContent = fmt(iva);
    document.getElementById('totalDisplay').textContent = fmt(total);
    document.getElementById('itemsJson').value = JSON.stringify(items);
  }
</script>
