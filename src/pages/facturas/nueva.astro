---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { store } from '../../lib/store';

let error = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const clienteId = formData.get('clienteId')?.toString() ?? '';
  const almacenId = formData.get('almacenId')?.toString() ?? '';
  const impuestoId = formData.get('impuestoId')?.toString() ?? '';
  const cliente = await store.getCliente(clienteId);

  if (!cliente) {
    error = 'Seleccione un cliente válido.';
  } else {
    const itemsJson = formData.get('items_json')?.toString() ?? '[]';
    let items;
    try { items = JSON.parse(itemsJson); } catch { items = []; }

    if (items.length === 0) {
      error = 'Agregue al menos un producto o servicio a la factura.';
    } else {
      // Impuesto dinámico
      let impuestoPorcentaje = 16;
      let impuestoNombre = 'IVA';
      if (impuestoId) {
        const imp = (await store.getImpuestos()).find(i => String(i.id) === impuestoId);
        if (imp) { impuestoPorcentaje = imp.porcentaje; impuestoNombre = imp.nombre; }
      }

      const subtotal = items.reduce((sum: number, item: { subtotal: number }) => sum + item.subtotal, 0);
      const iva = subtotal * (impuestoPorcentaje / 100);
      const total = subtotal + iva;

      let almacenNombre = '';
      if (almacenId) {
        const almacen = await store.getAlmacen(almacenId);
        almacenNombre = almacen?.nombre ?? '';
      }

      const fechaVencimiento = formData.get('fechaVencimiento')?.toString() || undefined;

      await store.createFactura({
        clienteId,
        clienteNombre: cliente.nombre,
        almacenId: almacenId || undefined,
        almacenNombre: almacenNombre || undefined,
        items,
        subtotal,
        iva,
        total,
        estado: 'pendiente',
        fecha: new Date().toISOString().split('T')[0],
        fechaVencimiento,
        impuestoId: impuestoId || undefined,
        impuestoNombre,
        impuestoPorcentaje,
      });

      return Astro.redirect('/facturas');
    }
  }
}

const [clientes, almacenes, allProductos, allServicios, impuestos, impuestoDefault] = await Promise.all([
  store.getClientes(),
  store.getAlmacenes(),
  store.getProductos(),
  store.getServicios(),
  store.getImpuestos(),
  store.getImpuestoDefault(),
]);
const productos = allProductos.filter(p => p.activo);
const servicios = allServicios.filter(s => s.activo);
const moneda = Astro.locals.moneda ?? { simbolo: '$', codigo: 'MXN' };

const allItems = [
  ...productos.map(p => ({
    tipo: 'producto',
    id: String(p.id),
    nombre: p.nombre,
    precio: p.precio,
    // Kits & compuestos: inventory deducted from components, not from product stock
    stock: (p.tipoProducto === 'kit' || p.tipoProducto === 'compuesto') ? 999999 : (p.stock ?? 0),
    esKit: p.tipoProducto === 'kit',
    esReceta: p.tipoProducto === 'compuesto',
  })),
  ...servicios.map(s => ({ tipo: 'servicio', id: String(s.id), nombre: s.nombre, precio: s.precio, stock: 999999, esKit: false, esReceta: false })),
];
---

<AdminLayout title="Nueva Factura">
  <div class="page-header">
    <h1>Nueva Factura</h1>
    <a href="/facturas" class="btn btn-secondary">
      <span class="material-icons-round">arrow_back</span> Volver
    </a>
  </div>

  {error && <div class="alert alert-error">{error}</div>}

  <script is:inline set:html={`window.__facturaItems = ${JSON.stringify(allItems)};`}></script>

  <form method="POST" id="facturaForm">
    <input type="hidden" name="items_json" id="itemsJson" value="[]" />

    <div class="card" style="margin-bottom:16px">
      <h2 style="font-size:1.1rem;margin-bottom:16px">Datos de la Factura</h2>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr 1fr;gap:16px">
        <div class="form-group">
          <label>Cliente</label>
          <select name="clienteId" class="form-control" required>
            <option value="">Seleccionar cliente...</option>
            {clientes.map(c => (
              <option value={c.id}>{c.nombre} - {c.rfc}</option>
            ))}
          </select>
        </div>
        <div class="form-group">
          <label>Almacén <span style="color:var(--danger)">*</span> <small style="color:var(--text-muted);font-weight:400">(requerido para descontar inventario)</small></label>
          <select name="almacenId" id="almacenSelect" class="form-control" onchange="checkAlmacen()">
            <option value="">— Sin afectar inventario —</option>
            {almacenes.filter(a => a.activo).map(a => (
              <option value={a.id}>{a.nombre}</option>
            ))}
          </select>
          <div id="almacenWarning" style="display:none;margin-top:6px;padding:8px 12px;background:#fef3c7;border:1px solid #fcd34d;border-radius:6px;font-size:0.8rem;color:#92400e;display:flex;align-items:center;gap:6px">
            <span class="material-icons-round" style="font-size:16px">warning</span>
            Sin almacén seleccionado, los productos <strong>no descontarán inventario</strong> al facturar.
          </div>
        </div>
        <div class="form-group">
          <label>Fecha</label>
          <input type="date" class="form-control" value={new Date().toISOString().split('T')[0]} disabled />
        </div>
        <div class="form-group">
          <label>Fecha de Vencimiento</label>
          <input type="date" name="fechaVencimiento" class="form-control" placeholder="Opcional" />
          <small style="color:var(--text-muted);font-size:0.78rem">Para seguimiento de cuentas por cobrar</small>
        </div>
        <div class="form-group">
          <label>Impuesto</label>
          <select name="impuestoId" id="impuestoSelect" class="form-control"
            onchange="updateImpuesto(this.value)">
            <option value="">Sin impuesto (0%)</option>
            {impuestos.filter(i => i.activo).map(i => (
              <option value={i.id}
                data-pct={i.porcentaje}
                data-nombre={i.nombre}
                selected={String(i.id) === String(impuestoDefault?.id)}>
                {i.nombre} ({i.porcentaje}%)
              </option>
            ))}
          </select>
        </div>
      </div>
    </div>

    <div class="card" style="margin-bottom:16px;position:relative;z-index:2">
      <h2 style="font-size:1.1rem;margin-bottom:16px">Productos y Servicios</h2>

      <div style="display:grid;grid-template-columns:2fr 1fr auto;gap:8px;margin-bottom:16px;align-items:end">
        <div class="form-group" style="margin-bottom:0">
          <label>Producto / Servicio</label>
          <div style="position:relative">
            <input
              type="text"
              id="searchItem"
              class="form-control"
              placeholder="Buscar producto o servicio..."
              autocomplete="off"
              oninput="filterItems(this.value)"
              onfocus="filterItems(this.value)"
              onblur="hideResults()"
            />
            <div id="searchResults" class="search-dropdown" style="display:none"></div>
          </div>
        </div>
        <div class="form-group" style="margin-bottom:0">
          <label>Cantidad</label>
          <input type="number" id="cantidad" class="form-control" min="1" value="1" />
        </div>
        <button type="button" class="btn btn-success" onclick="addItem()" style="height:38px">
          <span class="material-icons-round" style="font-size:18px">add</span> Agregar
        </button>
      </div>

      <table>
        <thead>
          <tr>
            <th>Descripción</th>
            <th>Tipo</th>
            <th>P. Unitario</th>
            <th>Cantidad</th>
            <th>Subtotal</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="itemsBody">
          <tr>
            <td colspan="6" style="text-align:center;color:var(--text-muted)">No se han agregado items.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="card">
      <div class="totals">
        <div class="total-row">
          <span>Subtotal:</span>
          <span id="subtotalDisplay">{moneda.simbolo}0.00</span>
        </div>
        <div class="total-row">
          <span id="ivaLabel">Impuesto ({impuestoDefault ? impuestoDefault.porcentaje + '%' : '0%'}):</span>
          <span id="ivaDisplay">{moneda.simbolo}0.00</span>
        </div>
        <div class="total-row total-final">
          <span>Total:</span>
          <span id="totalDisplay">{moneda.simbolo}0.00</span>
        </div>
      </div>

      <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:20px">
        <a href="/facturas" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">
          <span class="material-icons-round" style="font-size:18px">save</span> Crear Factura
        </button>
      </div>
    </div>
  </form>
</AdminLayout>

<style>
  .totals { max-width: 300px; margin-left: auto; }
  .total-row { display: flex; justify-content: space-between; padding: 8px 0; font-size: 0.95rem; }
  .total-row + .total-row { border-top: 1px solid var(--border); }
  .total-final { font-size: 1.15rem; font-weight: 700; color: var(--primary); }
</style>

<style is:global>
  .search-dropdown {
    position: absolute; top: 100%; left: 0; right: 0; z-index: 200;
    background: white; border: 1px solid var(--border); border-radius: var(--radius);
    max-height: 280px; overflow-y: auto; box-shadow: 0 4px 16px rgba(0,0,0,.12);
    margin-top: 2px;
  }
  .search-result-item {
    padding: 9px 14px; cursor: pointer; border-bottom: 1px solid var(--border);
    font-size: 0.875rem; display: flex; align-items: center; gap: 10px;
  }
  .search-result-item:last-child { border-bottom: none; }
  .search-result-item:hover { background: #f0f7ff; }
  .search-result-item .item-name { flex: 1; font-weight: 500; color: var(--text); }
  .search-result-item .item-price { color: var(--text-muted); font-size: 0.82rem; white-space: nowrap; }
  .search-result-item .item-stock { color: var(--text-muted); font-size: 0.78rem; white-space: nowrap; }
</style>

<script is:inline>
  var __allItems = window.__facturaItems || [];
  var selectedItem = null;
  var items = [];
  var __impuestoPct = 0;

  // Inicializar con el impuesto por defecto seleccionado
  (function() {
    var sel = document.getElementById('impuestoSelect');
    if (sel && sel.value) {
      var opt = sel.options[sel.selectedIndex];
      __impuestoPct = parseFloat(opt.dataset.pct || '0');
    }
  })();

  function updateImpuesto(id) {
    var sel = document.getElementById('impuestoSelect');
    if (!id) {
      __impuestoPct = 0;
      document.getElementById('ivaLabel').textContent = 'Impuesto (0%):';
    } else {
      var opt = sel.options[sel.selectedIndex];
      __impuestoPct = parseFloat(opt.dataset.pct || '0');
      document.getElementById('ivaLabel').textContent = opt.dataset.nombre + ' (' + __impuestoPct + '%):';
    }
    renderItems();
  }

  var __m = window.__moneda || { simbolo: '$' };
  function fmt(n) { return __m.simbolo + n.toLocaleString('es-MX', { minimumFractionDigits: 2 }); }

  function escHtml(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function filterItems(q) {
    q = (q || '').toLowerCase().trim();
    var results = q.length > 0
      ? __allItems.filter(function(i) { return i.nombre.toLowerCase().includes(q); })
      : __allItems.slice(0, 30);
    var el = document.getElementById('searchResults');
    if (!results.length) { el.style.display = 'none'; return; }
    el.innerHTML = results.slice(0, 25).map(function(i) {
      var badge = i.esKit
        ? '<span style="font-size:0.7rem;font-weight:600;padding:2px 7px;border-radius:10px;background:#fef9c3;color:#854d0e;white-space:nowrap">Kit</span>'
        : i.esReceta
          ? '<span style="font-size:0.7rem;font-weight:600;padding:2px 7px;border-radius:10px;background:#ffedd5;color:#9a3412;white-space:nowrap">Receta</span>'
          : '';
      var stockInfo = (i.tipo === 'producto' && !i.esKit && !i.esReceta)
        ? '<span class="item-stock">Stock: ' + i.stock + '</span>'
        : '';
      return '<div class="search-result-item"'
        + ' data-id="' + escHtml(i.id) + '"'
        + ' data-tipo="' + escHtml(i.tipo) + '"'
        + ' data-nombre="' + escHtml(i.nombre) + '"'
        + ' data-precio="' + i.precio + '"'
        + ' data-stock="' + i.stock + '"'
        + ' onmousedown="selectItem(this)">'
        + badge
        + '<span class="item-name">' + escHtml(i.nombre) + '</span>'
        + '<span class="item-price">' + fmt(i.precio) + '</span>'
        + stockInfo
        + '</div>';
    }).join('');
    el.style.display = 'block';
  }

  function hideResults() {
    setTimeout(function() { document.getElementById('searchResults').style.display = 'none'; }, 150);
  }

  function selectItem(el) {
    selectedItem = {
      tipo: el.dataset.tipo,
      id: el.dataset.id,
      nombre: el.dataset.nombre,
      precio: parseFloat(el.dataset.precio),
      stock: parseInt(el.dataset.stock),
    };
    document.getElementById('searchItem').value = el.dataset.nombre;
    document.getElementById('searchResults').style.display = 'none';
  }

  function addItem() {
    if (!selectedItem) return alert('Seleccione un producto o servicio.');
    var cantInput = document.getElementById('cantidad');
    var cantidad = parseInt(cantInput.value) || 1;
    if (cantidad <= 0) return alert('La cantidad debe ser mayor a 0.');
    if (selectedItem.tipo === 'producto' && cantidad > selectedItem.stock) {
      return alert('Stock insuficiente. Disponible: ' + selectedItem.stock);
    }
    var existing = items.find(function(i) { return i.tipo === selectedItem.tipo && i.productoId === selectedItem.id; });
    if (existing) {
      existing.cantidad += cantidad;
      existing.subtotal = existing.cantidad * existing.precioUnitario;
    } else {
      items.push({ tipo: selectedItem.tipo, productoId: selectedItem.id, productoNombre: selectedItem.nombre, cantidad: cantidad, precioUnitario: selectedItem.precio, subtotal: cantidad * selectedItem.precio });
    }
    document.getElementById('searchItem').value = '';
    selectedItem = null;
    cantInput.value = '1';
    renderItems();
  }

  function removeItem(index) {
    items.splice(index, 1);
    renderItems();
  }

  function renderItems() {
    var tbody = document.getElementById('itemsBody');
    if (items.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--text-muted)">No se han agregado items.</td></tr>';
    } else {
      tbody.innerHTML = items.map(function(item, i) {
        return '<tr>'
          + '<td>' + escHtml(item.productoNombre) + '</td>'
          + '<td>' + (item.tipo === 'servicio'
            ? '<span style="background:var(--bg);color:var(--text-muted);padding:2px 8px;border-radius:12px;font-size:0.75rem;font-weight:600">Servicio</span>'
            : '<span style="background:#dcfce7;color:#16a34a;padding:2px 8px;border-radius:12px;font-size:0.75rem;font-weight:600">Producto</span>') + '</td>'
          + '<td>' + fmt(item.precioUnitario) + '</td>'
          + '<td>' + item.cantidad + '</td>'
          + '<td><strong>' + fmt(item.subtotal) + '</strong></td>'
          + '<td><button type="button" class="btn btn-danger btn-sm" onclick="removeItem(' + i + ')">'
          + '<span class="material-icons-round" style="font-size:16px">close</span></button></td>'
          + '</tr>';
      }).join('');
    }

    var subtotal = items.reduce(function(s, i) { return s + i.subtotal; }, 0);
    var iva = subtotal * (__impuestoPct / 100);
    var total = subtotal + iva;

    document.getElementById('subtotalDisplay').textContent = fmt(subtotal);
    document.getElementById('ivaDisplay').textContent = fmt(iva);
    document.getElementById('totalDisplay').textContent = fmt(total);
    document.getElementById('itemsJson').value = JSON.stringify(items);

    // Show warning if products in list but no almacen selected
    var hasProductos = items.some(function(i) { return i.tipo === 'producto'; });
    var almacenVal = document.getElementById('almacenSelect')?.value;
    var warn = document.getElementById('almacenWarning');
    if (warn) warn.style.display = (hasProductos && !almacenVal) ? 'flex' : 'none';
  }

  function checkAlmacen() {
    renderItems();
  }
</script>
