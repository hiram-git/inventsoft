---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { store } from '../../../lib/store';

const { id } = Astro.params;
const proveedor = await store.getProveedor(id!);
if (!proveedor) return Astro.redirect('/proveedores');

let error = '';

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const g = (k: string) => f.get(k)?.toString() ?? '';
  const nombre = g('nombre').trim();
  if (!nombre) {
    error = 'El nombre del proveedor es requerido.';
  } else {
    await store.updateProveedor(id!, {
      nombre,
      rfc:      g('rfc'),
      contacto: g('contacto'),
      telefono: g('telefono'),
      email:    g('email'),
      direccion:g('direccion'),
      notas:    g('notas'),
      activo:   f.get('activo') === '1',
    });
    return Astro.redirect('/proveedores');
  }
}
---

<AdminLayout title="Editar Proveedor">
  <div class="page-header">
    <h1><span class="material-icons-round">local_shipping</span> Editar Proveedor</h1>
    <a href="/proveedores" class="btn btn-secondary">
      <span class="material-icons-round">arrow_back</span> Volver
    </a>
  </div>

  {error && <div class="alert alert-error"><span class="material-icons-round">error</span>{error}</div>}

  <form method="POST">
    <div class="card" style="margin-bottom:16px">
      <h2>Datos del Proveedor</h2>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
        <div class="form-group" style="grid-column:1/-1">
          <label>Nombre *</label>
          <input type="text" name="nombre" class="form-control" required value={proveedor.nombre} />
        </div>
        <div class="form-group">
          <label>RFC / NIT</label>
          <input type="text" name="rfc" class="form-control" value={proveedor.rfc ?? ''} />
        </div>
        <div class="form-group">
          <label>Persona de Contacto</label>
          <input type="text" name="contacto" class="form-control" value={proveedor.contacto ?? ''} />
        </div>
        <div class="form-group">
          <label>Teléfono</label>
          <input type="text" name="telefono" class="form-control" value={proveedor.telefono ?? ''} />
        </div>
        <div class="form-group">
          <label>Email</label>
          <input type="email" name="email" class="form-control" value={proveedor.email ?? ''} />
        </div>
        <div class="form-group" style="grid-column:1/-1">
          <label>Dirección</label>
          <textarea name="direccion" class="form-control" rows="2">{proveedor.direccion ?? ''}</textarea>
        </div>
        <div class="form-group" style="grid-column:1/-1">
          <label>Notas internas</label>
          <textarea name="notas" class="form-control" rows="2">{proveedor.notas ?? ''}</textarea>
        </div>
        <div class="form-group">
          <label style="display:flex;align-items:center;gap:10px;cursor:pointer">
            <input type="checkbox" name="activo" value="1" checked={proveedor.activo} style="width:16px;height:16px" />
            <span>Proveedor activo</span>
          </label>
        </div>
      </div>
    </div>

    <div style="display:flex;gap:12px;justify-content:flex-end">
      <a href="/proveedores" class="btn btn-secondary">Cancelar</a>
      <button type="submit" class="btn btn-primary">
        <span class="material-icons-round">save</span> Guardar Cambios
      </button>
    </div>
  </form>
</AdminLayout>

<style>
  .page-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:24px; }
  h1 { font-size:1.5rem; font-weight:700; margin:0; display:flex; align-items:center; gap:8px; }
  h2 { font-size:1rem; font-weight:600; margin:0 0 16px; }
  .alert { display:flex; align-items:center; gap:8px; padding:12px 16px; border-radius:var(--radius); margin-bottom:16px; font-size:0.875rem; }
  .alert-error { background:#fef2f2; color:#dc2626; border:1px solid #fecaca; }
  .card { background:white; border:1px solid var(--border); border-radius:var(--radius); padding:24px; }
  .form-group { display:flex; flex-direction:column; gap:6px; }
  label { font-size:0.875rem; font-weight:500; color:var(--text); }
  .form-control { padding:8px 12px; border:1px solid var(--border); border-radius:var(--radius); font-size:0.875rem; outline:none; transition:border-color .2s; width:100%; box-sizing:border-box; }
  .form-control:focus { border-color:var(--primary); }
  textarea.form-control { resize:vertical; }
  .btn { display:inline-flex; align-items:center; gap:6px; padding:8px 16px; border-radius:var(--radius); font-size:0.875rem; font-weight:500; border:1px solid transparent; cursor:pointer; text-decoration:none; transition:all .2s; }
  .btn-primary { background:var(--primary); color:white; }
  .btn-primary:hover { background:var(--primary-dark); }
  .btn-secondary { background:white; border-color:var(--border); color:var(--text); }
  .btn-secondary:hover { background:#f8fafc; }
</style>
