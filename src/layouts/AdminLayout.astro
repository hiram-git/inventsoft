---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const user = Astro.locals.user;
const currentPath = Astro.url.pathname;

const menuItems = [
  { href: '/dashboard',    label: 'Dashboard',       icon: 'dashboard' },
  { href: '/clientes',     label: 'Clientes',        icon: 'people' },
  { href: '/productos',    label: 'Productos',       icon: 'inventory' },
  { href: '/servicios',    label: 'Servicios',       icon: 'build' },
  { href: '/kits',         label: 'Kits',            icon: 'workspaces' },
  { href: '/vendedores',   label: 'Vendedores',       icon: 'badge' },
  { href: '/catalogos',    label: 'Catálogos',        icon: 'category' },
  { href: '/cotizaciones', label: 'Cotizaciones',    icon: 'request_quote' },
  { href: '/facturas',     label: 'Facturas',        icon: 'receipt' },
  { href: '/notas-credito',label: 'Notas de Crédito',icon: 'undo' },
  { href: '/pedidos',      label: 'Pedidos',         icon: 'shopping_cart' },
];

const cobrosItems = [
  { href: '/cuentas-por-cobrar', label: 'Cuentas por Cobrar', icon: 'account_balance_wallet' },
  { href: '/cobros', label: 'Cobros', icon: 'payments' },
];

const inventarioItems = [
  { href: '/almacenes', label: 'Almacenes', icon: 'warehouse' },
  { href: '/inventario', label: 'Inventario', icon: 'view_list' },
  { href: '/compras', label: 'Compras', icon: 'local_shipping' },
  { href: '/kardex', label: 'Kardex', icon: 'swap_vert' },
];

const cocinaItems = [
  { href: '/comandas', label: 'Comandas (Cocina)', icon: 'restaurant' },
  { href: '/comandas/nueva', label: 'Nueva Comanda', icon: 'add_circle_outline' },
];

const reportesItems = [
  { href: '/reportes/ventas', label: 'Ventas Mensuales', icon: 'bar_chart' },
];

const configItems = [
  { href: '/configuracion/empresa',   label: 'Empresa',   icon: 'business' },
  { href: '/configuracion/impresora', label: 'Impresora', icon: 'print' },
  { href: '/configuracion/usuarios',  label: 'Usuarios',  icon: 'manage_accounts' },
  { href: '/configuracion/roles',     label: 'Roles',     icon: 'admin_panel_settings' },
  { href: '/configuracion/permisos',  label: 'Permisos',  icon: 'lock' },
];
---

<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} - Admin Portal</title>
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet" />
</head>
<body>
  <!-- Sidebar -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 2L2 7l10 5 10-5-10-5z"/>
        <path d="M2 17l10 5 10-5"/>
        <path d="M2 12l10 5 10-5"/>
      </svg>
      <span class="sidebar-brand">Admin Portal</span>
    </div>

    <nav class="sidebar-nav">
      <div class="nav-section" data-section="principal">
        <button class="nav-section-title" type="button">
          <span>Principal</span>
          <span class="material-icons-round section-chevron">expand_less</span>
        </button>
        <div class="nav-section-links">
          {menuItems.map(item => (
            <a href={item.href} class:list={['nav-link', { active: currentPath.startsWith(item.href) }]} title={item.label}>
              <span class="material-icons-round">{item.icon}</span>
              <span class="nav-link-label">{item.label}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="nav-section" data-section="cobros">
        <button class="nav-section-title" type="button">
          <span>Gestión de Cobros</span>
          <span class="material-icons-round section-chevron">expand_less</span>
        </button>
        <div class="nav-section-links">
          {cobrosItems.map(item => (
            <a href={item.href} class:list={['nav-link', { active: currentPath.startsWith(item.href) }]} title={item.label}>
              <span class="material-icons-round">{item.icon}</span>
              <span class="nav-link-label">{item.label}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="nav-section" data-section="inventario">
        <button class="nav-section-title" type="button">
          <span>Control de Inventario</span>
          <span class="material-icons-round section-chevron">expand_less</span>
        </button>
        <div class="nav-section-links">
          {inventarioItems.map(item => (
            <a href={item.href} class:list={['nav-link', { active: currentPath.startsWith(item.href) }]} title={item.label}>
              <span class="material-icons-round">{item.icon}</span>
              <span class="nav-link-label">{item.label}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="nav-section" data-section="cocina">
        <button class="nav-section-title" type="button">
          <span>Cocina</span>
          <span class="material-icons-round section-chevron">expand_less</span>
        </button>
        <div class="nav-section-links">
          {cocinaItems.map(item => (
            <a href={item.href} class:list={['nav-link', { active: currentPath.startsWith(item.href) && item.href !== '/comandas/nueva' || currentPath === item.href }]} title={item.label}>
              <span class="material-icons-round">{item.icon}</span>
              <span class="nav-link-label">{item.label}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="nav-section" data-section="reportes">
        <button class="nav-section-title" type="button">
          <span>Reportes</span>
          <span class="material-icons-round section-chevron">expand_less</span>
        </button>
        <div class="nav-section-links">
          {reportesItems.map(item => (
            <a href={item.href} class:list={['nav-link', { active: currentPath.startsWith(item.href) }]} title={item.label}>
              <span class="material-icons-round">{item.icon}</span>
              <span class="nav-link-label">{item.label}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="nav-section" data-section="configuracion">
        <button class="nav-section-title" type="button">
          <span>Configuración</span>
          <span class="material-icons-round section-chevron">expand_less</span>
        </button>
        <div class="nav-section-links">
          {configItems.map(item => (
            <a href={item.href} class:list={['nav-link', { active: currentPath.startsWith(item.href) }]} title={item.label}>
              <span class="material-icons-round">{item.icon}</span>
              <span class="nav-link-label">{item.label}</span>
            </a>
          ))}
        </div>
      </div>
    </nav>
  </aside>

  <!-- Main Content -->
  <div class="main-wrapper">
    <!-- Navbar -->
    <header class="navbar">
      <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu" title="Colapsar menú">
        <span class="material-icons-round">menu</span>
      </button>

      <div class="navbar-right">
        <div class="user-info">
          <div class="user-avatar">
            {user.nombre.charAt(0).toUpperCase()}
          </div>
          <div class="user-details">
            <span class="user-name">{user.nombre}</span>
            <span class="user-role">{user.rol}</span>
          </div>
        </div>
        <form method="POST" action="/api/auth/logout">
          <button type="submit" class="btn-logout" title="Cerrar sesión">
            <span class="material-icons-round">logout</span>
            <span class="logout-text">Salir</span>
          </button>
        </form>
      </div>
    </header>

    <!-- Page Content -->
    <main class="content">
      <slot />
    </main>
  </div>

  <!-- Toast container -->
  <div id="ui-toasts" aria-live="polite"></div>
</body>
</html>

<style>
  /* ─── Sidebar ─────────────────────────────────────────────── */
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: var(--sidebar-width);
    height: 100vh;
    background: #1e293b;
    color: white;
    display: flex;
    flex-direction: column;
    z-index: 100;
    transition: width 0.25s ease, transform 0.25s ease;
    overflow: hidden;
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 20px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    flex-shrink: 0;
    white-space: nowrap;
  }

  .sidebar-brand {
    font-size: 1.1rem;
    font-weight: 700;
    transition: opacity 0.2s, width 0.2s;
  }

  .sidebar-nav {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 8px 0;
  }

  /* hide scrollbar when collapsed */
  .sidebar-nav::-webkit-scrollbar { width: 4px; }
  .sidebar-nav::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 4px; }

  .nav-section {
    padding: 8px 12px;
  }

  .nav-section-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.4);
    padding: 8px 12px 4px;
    font-weight: 600;
    white-space: nowrap;
    background: none;
    border: none;
    cursor: pointer;
    transition: color 0.2s;
  }

  .nav-section-title:hover {
    color: rgba(255,255,255,0.7);
  }

  .section-chevron {
    font-size: 16px !important;
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  .nav-section.collapsed .section-chevron {
    transform: rotate(-90deg);
  }

  .nav-section-links {
    overflow: hidden;
    max-height: 600px;
    transition: max-height 0.3s ease;
  }

  .nav-section.collapsed .nav-section-links {
    max-height: 0;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 8px;
    font-size: 0.9rem;
    color: rgba(255,255,255,0.7);
    transition: background 0.2s, color 0.2s, padding 0.25s, justify-content 0.25s;
    white-space: nowrap;
    text-decoration: none;
  }

  .nav-link:hover {
    background: rgba(255,255,255,0.1);
    color: white;
  }

  .nav-link.active {
    background: var(--primary);
    color: white;
  }

  .nav-link .material-icons-round {
    font-size: 20px;
    flex-shrink: 0;
  }

  .nav-link-label {
    transition: opacity 0.2s;
  }

  /* ─── Collapsed state (desktop) ──────────────────────────── */
  .sidebar.collapsed {
    width: 64px;
  }

  .sidebar.collapsed .sidebar-brand {
    opacity: 0;
    width: 0;
    overflow: hidden;
  }

  .sidebar.collapsed .nav-section-title {
    justify-content: center;
    padding: 8px 0 4px;
  }

  .sidebar.collapsed .nav-section-title > span:first-child,
  .sidebar.collapsed .section-chevron {
    display: none;
  }

  .sidebar.collapsed .nav-link {
    justify-content: center;
    padding: 10px 0;
  }

  .sidebar.collapsed .nav-link-label {
    opacity: 0;
    width: 0;
    overflow: hidden;
  }

  /* ─── Main wrapper ────────────────────────────────────────── */
  .main-wrapper {
    margin-left: var(--sidebar-width);
    min-height: 100vh;
    transition: margin-left 0.25s ease;
  }

  .sidebar.collapsed + .main-wrapper {
    margin-left: 64px;
  }

  /* ─── Navbar ──────────────────────────────────────────────── */
  .navbar {
    position: sticky;
    top: 0;
    height: var(--navbar-height);
    background: white;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 0 24px;
    z-index: 50;
    gap: 12px;
  }

  .menu-toggle {
    background: none;
    border: none;
    font-size: 1.5rem;
    color: var(--text);
    margin-right: auto;
    cursor: pointer;
    padding: 4px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    transition: background 0.2s;
  }

  .menu-toggle:hover {
    background: var(--bg);
  }

  .navbar-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .user-info {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .user-avatar {
    width: 36px;
    height: 36px;
    background: var(--primary);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.9rem;
  }

  .user-details {
    display: flex;
    flex-direction: column;
  }

  .user-name {
    font-weight: 600;
    font-size: 0.875rem;
    line-height: 1.2;
  }

  .user-role {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .btn-logout {
    display: flex;
    align-items: center;
    gap: 4px;
    background: none;
    border: 1px solid var(--border);
    padding: 6px 12px;
    border-radius: var(--radius);
    color: var(--danger);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-logout:hover {
    background: #fef2f2;
    border-color: var(--danger);
  }

  .btn-logout .material-icons-round {
    font-size: 18px;
  }

  /* ─── DataTable: estilos migrados a Tailwind v4 (ver ui.ts + global.css) ── */
  /* .card--table vive en global.css (@layer components) */
  /* El toolbar y footer usan clases utilitarias de Tailwind directamente.   */

  /* ─── Content ─────────────────────────────────────────────── */
  .content {
    padding: 24px;
  }

  /* ─── Toast notifications ─────────────────────────────────── */
  #ui-toasts {
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 8px;
    pointer-events: none;
  }

  .ui-toast {
    display: flex;
    align-items: center;
    gap: 10px;
    background: white;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 12px 14px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.12);
    font-size: 0.875rem;
    min-width: 280px;
    max-width: 380px;
    pointer-events: all;
  }

  .ui-toast-msg {
    flex: 1;
    line-height: 1.4;
  }

  .ui-toast-close {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-muted);
    padding: 2px;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    border-radius: 4px;
    transition: background 0.15s;
  }

  .ui-toast-close:hover { background: var(--bg); }

  /* ─── Button spinner ──────────────────────────────────────── */
  @keyframes ui-spin {
    to { transform: rotate(360deg); }
  }

  .ui-spinner {
    animation: ui-spin 0.8s linear infinite;
    font-size: 16px !important;
  }

  /* ─── Mobile ──────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .sidebar {
      width: var(--sidebar-width) !important; /* restore full width on mobile */
      transform: translateX(-100%);
    }

    .sidebar.open {
      transform: translateX(0);
    }

    /* Remove collapsed icon-only mode on mobile */
    .sidebar.collapsed {
      width: var(--sidebar-width) !important;
    }

    .sidebar.collapsed .sidebar-brand { opacity: 1; width: auto; overflow: visible; }
    .sidebar.collapsed .nav-section-title { justify-content: space-between; padding: 8px 12px 4px; }
    .sidebar.collapsed .nav-section-title > span:first-child,
    .sidebar.collapsed .section-chevron { display: inline-flex; }
    .sidebar.collapsed .nav-link { justify-content: flex-start; padding: 10px 12px; }
    .sidebar.collapsed .nav-link-label { opacity: 1; width: auto; overflow: visible; }

    .main-wrapper,
    .sidebar.collapsed + .main-wrapper {
      margin-left: 0;
    }

    /* Mobile overlay backdrop */
    .sidebar-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.4);
      z-index: 99;
    }
    .sidebar-backdrop.visible { display: block; }

    .user-details { display: none; }
    .logout-text  { display: none; }
  }
</style>

<!-- Backdrop for mobile -->
<div class="sidebar-backdrop" id="sidebarBackdrop"></div>

<script>
  const toggle   = document.getElementById('menuToggle')!;
  const sidebar  = document.getElementById('sidebar')!;
  const backdrop = document.getElementById('sidebarBackdrop')!;
  const isMobile = () => window.innerWidth <= 768;

  // ── Sidebar collapse (hamburger) ───────────────────────────
  if (!isMobile() && localStorage.getItem('sidebarCollapsed') === 'true') {
    sidebar.classList.add('collapsed');
  }

  toggle.addEventListener('click', () => {
    if (isMobile()) {
      const isOpen = sidebar.classList.toggle('open');
      backdrop.classList.toggle('visible', isOpen);
    } else {
      const isCollapsed = sidebar.classList.toggle('collapsed');
      localStorage.setItem('sidebarCollapsed', String(isCollapsed));
    }
  });

  backdrop.addEventListener('click', () => {
    sidebar.classList.remove('open');
    backdrop.classList.remove('visible');
  });

  window.addEventListener('resize', () => {
    if (!isMobile()) {
      sidebar.classList.remove('open');
      backdrop.classList.remove('visible');
    }
  });

  // ── Section accordions ─────────────────────────────────────
  const collapsedSections: Set<string> = new Set(
    JSON.parse(localStorage.getItem('collapsedSections') ?? '[]')
  );

  // Restore collapsed state
  document.querySelectorAll<HTMLElement>('.nav-section[data-section]').forEach(section => {
    const id = section.dataset.section!;
    if (collapsedSections.has(id)) section.classList.add('collapsed');

    section.querySelector('.nav-section-title')!.addEventListener('click', () => {
      // Don't toggle when sidebar is in icon-only mode
      if (sidebar.classList.contains('collapsed')) return;

      section.classList.toggle('collapsed');
      if (section.classList.contains('collapsed')) {
        collapsedSections.add(id);
      } else {
        collapsedSections.delete(id);
      }
      localStorage.setItem('collapsedSections', JSON.stringify([...collapsedSections]));
    });
  });
</script>

<!-- Global UI animations & toast system -->
<script>
  import '../scripts/ui';
</script>
