---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { store } from '../../lib/store';

const compraId = Astro.url.searchParams.get('compra') ?? '';
const saldoInfo = compraId ? await store.getSaldoCompra(compraId) : null;

if (!saldoInfo) return Astro.redirect('/cuentas-por-pagar');

let error = '';

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const monto = parseFloat(f.get('monto')?.toString() ?? '0');
  if (!monto || monto <= 0) {
    error = 'El monto debe ser mayor a 0.';
  } else if (monto > saldoInfo.saldo + 0.01) {
    error = `El monto no puede superar el saldo pendiente de ${saldoInfo.saldo.toFixed(2)}.`;
  } else {
    await store.createPagoProveedor({
      compraId,
      compraNumero: saldoInfo.compra.numero,
      proveedorId: saldoInfo.compra.proveedorId ?? undefined,
      proveedorNombre: saldoInfo.compra.proveedorNombre,
      monto,
      fecha: f.get('fecha')?.toString() ?? new Date().toISOString().split('T')[0],
      metodoPago: f.get('metodoPago')?.toString() ?? 'transferencia',
      referencia: f.get('referencia')?.toString() ?? '',
      cuentaBancaria: f.get('cuentaBancaria')?.toString() ?? '',
      notas: f.get('notas')?.toString() ?? '',
    });
    return Astro.redirect('/cuentas-por-pagar');
  }
}

const { compra, totalPagado, saldo, estadoPago } = saldoInfo;
const moneda = Astro.locals.moneda ?? { simbolo: '$' };
const fmt = (n: number) => moneda.simbolo + n.toLocaleString('es-MX', { minimumFractionDigits: 2 });
const today = new Date().toISOString().split('T')[0];
---

<AdminLayout title="Registrar Pago a Proveedor">
  <div class="page-header">
    <h1><span class="material-icons-round">payments</span> Registrar Pago</h1>
    <a href="/cuentas-por-pagar" class="btn btn-secondary">
      <span class="material-icons-round">arrow_back</span> Volver
    </a>
  </div>

  {error && <div class="alert alert-error"><span class="material-icons-round">error</span>{error}</div>}

  <!-- Compra summary -->
  <div class="card" style="margin-bottom:16px">
    <h2>Compra: {compra.numero}</h2>
    <div class="info-grid">
      <div class="info-item">
        <span class="info-label">Proveedor</span>
        <span class="info-value">{compra.proveedorNombre}</span>
      </div>
      <div class="info-item">
        <span class="info-label">Fecha compra</span>
        <span class="info-value">{compra.fecha}</span>
      </div>
      <div class="info-item">
        <span class="info-label">Total compra</span>
        <span class="info-value"><strong>{fmt(compra.total)}</strong></span>
      </div>
      <div class="info-item">
        <span class="info-label">Ya pagado</span>
        <span class="info-value">{fmt(totalPagado)}</span>
      </div>
      <div class="info-item">
        <span class="info-label">Saldo pendiente</span>
        <span class="info-value saldo-pending"><strong>{fmt(saldo)}</strong></span>
      </div>
      <div class="info-item">
        <span class="info-label">Estado</span>
        <span class:list={['badge', estadoPago === 'pagada' ? 'badge-success' : estadoPago === 'parcial' ? 'badge-info' : 'badge-warning']}>
          {estadoPago}
        </span>
      </div>
    </div>
  </div>

  <form method="POST">
    <div class="card" style="margin-bottom:16px">
      <h2>Datos del Pago</h2>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
        <div class="form-group">
          <label>Monto *</label>
          <input type="number" name="monto" class="form-control" step="0.01" min="0.01"
            max={saldo.toFixed(2)} value={saldo.toFixed(2)} required />
          <span style="font-size:0.75rem;color:var(--text-muted)">Máximo: {fmt(saldo)}</span>
        </div>
        <div class="form-group">
          <label>Fecha *</label>
          <input type="date" name="fecha" class="form-control" value={today} required />
        </div>
        <div class="form-group">
          <label>Método de Pago</label>
          <select name="metodoPago" class="form-control">
            <option value="transferencia">Transferencia bancaria</option>
            <option value="cheque">Cheque</option>
            <option value="efectivo">Efectivo</option>
            <option value="tarjeta">Tarjeta</option>
            <option value="otro">Otro</option>
          </select>
        </div>
        <div class="form-group">
          <label>Cuenta Bancaria / Origen</label>
          <input type="text" name="cuentaBancaria" class="form-control" placeholder="Ej: BBVA ***1234" />
        </div>
        <div class="form-group" style="grid-column:1/-1">
          <label>Referencia / Folio</label>
          <input type="text" name="referencia" class="form-control" placeholder="Número de transferencia, cheque, etc." />
        </div>
        <div class="form-group" style="grid-column:1/-1">
          <label>Notas</label>
          <textarea name="notas" class="form-control" rows="2" placeholder="Observaciones internas"></textarea>
        </div>
      </div>
    </div>

    <div style="display:flex;gap:12px;justify-content:flex-end">
      <a href="/cuentas-por-pagar" class="btn btn-secondary">Cancelar</a>
      <button type="submit" class="btn btn-primary">
        <span class="material-icons-round">save</span> Registrar Pago
      </button>
    </div>
  </form>
</AdminLayout>

<style>
  .page-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:24px; }
  h1 { font-size:1.5rem; font-weight:700; margin:0; display:flex; align-items:center; gap:8px; }
  h2 { font-size:1rem; font-weight:600; margin:0 0 16px; }
  .alert { display:flex; align-items:center; gap:8px; padding:12px 16px; border-radius:var(--radius); margin-bottom:16px; font-size:0.875rem; }
  .alert-error { background:#fef2f2; color:#dc2626; border:1px solid #fecaca; }
  .card { background:white; border:1px solid var(--border); border-radius:var(--radius); padding:24px; }
  .info-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
  .info-item { display:flex; flex-direction:column; gap:4px; }
  .info-label { font-size:0.72rem; text-transform:uppercase; letter-spacing:.05em; color:var(--text-muted); }
  .info-value { font-size:0.95rem; }
  .saldo-pending { color:#dc2626; }
  .badge { display:inline-block; padding:3px 10px; border-radius:12px; font-size:0.75rem; font-weight:600; }
  .badge-success { background:#dcfce7; color:#16a34a; }
  .badge-warning { background:#fef9c3; color:#ca8a04; }
  .badge-info    { background:#dbeafe; color:#2563eb; }
  .form-group { display:flex; flex-direction:column; gap:6px; }
  label { font-size:0.875rem; font-weight:500; }
  .form-control { padding:8px 12px; border:1px solid var(--border); border-radius:var(--radius); font-size:0.875rem; outline:none; width:100%; box-sizing:border-box; transition:border-color .2s; }
  .form-control:focus { border-color:var(--primary); }
  textarea.form-control { resize:vertical; }
  .btn { display:inline-flex; align-items:center; gap:6px; padding:8px 16px; border-radius:var(--radius); font-size:0.875rem; font-weight:500; border:1px solid transparent; cursor:pointer; text-decoration:none; transition:all .2s; }
  .btn-primary { background:var(--primary); color:white; }
  .btn-primary:hover { background:var(--primary-dark); }
  .btn-secondary { background:white; border-color:var(--border); color:var(--text); }
  .btn-secondary:hover { background:#f8fafc; }

  @media (max-width:768px) { .info-grid { grid-template-columns:1fr 1fr; } }
</style>
