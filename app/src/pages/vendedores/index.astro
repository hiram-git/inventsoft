---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { store } from '../../lib/store';

let mensaje = '';
let tipoMensaje = 'success';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action  = form.get('action')?.toString()  ?? '';
  const id      = parseInt(form.get('id')?.toString() ?? '0');
  const nombre  = form.get('nombre')?.toString()  ?? '';
  const email   = form.get('email')?.toString()   ?? '';
  const telefono= form.get('telefono')?.toString() ?? '';
  const activo  = form.get('activo') !== 'false';

  try {
    if (action === 'create') await store.createVendedor({ nombre, email, telefono });
    else if (action === 'update') await store.updateVendedor(id, { nombre, email, telefono, activo });
    else if (action === 'delete') await store.deleteVendedor(id);
    mensaje = action === 'delete' ? 'Vendedor eliminado.' :
              action === 'create' ? 'Vendedor creado.' : 'Vendedor actualizado.';
  } catch (e: any) {
    mensaje = e.message ?? 'Error al guardar.';
    tipoMensaje = 'error';
  }
  return Astro.redirect('/vendedores');
}

const vendedores = await store.getVendedores();
---

<AdminLayout title="Vendedores">
  <div class="page-header">
    <h1>Vendedores</h1>
    <button class="btn btn-primary" onclick="openPanel()">
      <span class="material-icons-round">add</span> Nuevo Vendedor
    </button>
  </div>

  {mensaje && <div class={`alert alert-${tipoMensaje}`}>{mensaje}</div>}

  <div style="display:grid;grid-template-columns:1fr 340px;gap:20px;align-items:start">
    <div class="card">
      <table data-searchable>
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Email</th>
            <th>Teléfono</th>
            <th>Estado</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          {vendedores.map(v => (
            <tr>
              <td>{v.nombre}</td>
              <td>{v.email || '—'}</td>
              <td>{v.telefono || '—'}</td>
              <td>
                {v.activo
                  ? <span class="badge badge-success">Activo</span>
                  : <span class="badge badge-secondary">Inactivo</span>}
              </td>
              <td>
                <div style="display:flex;gap:4px;">
                  <button class="btn btn-primary btn-sm"
                    onclick={`openEdit(${v.id},'${v.nombre.replace(/'/g,"\\'")}','${(v.email||'').replace(/'/g,"\\'")}','${(v.telefono||'').replace(/'/g,"\\'")}',${v.activo})`}>
                    <span class="material-icons-round" style="font-size:16px">edit</span>
                  </button>
                  <form method="POST" style="display:inline"
                    onsubmit="return confirm('¿Eliminar este vendedor?')">
                    <input type="hidden" name="action" value="delete" />
                    <input type="hidden" name="id" value={v.id} />
                    <button type="submit" class="btn btn-danger btn-sm">
                      <span class="material-icons-round" style="font-size:16px">delete</span>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          ))}
          {vendedores.length === 0 && (
            <tr><td colspan="5" style="text-align:center;color:var(--text-muted)">No hay vendedores registrados.</td></tr>
          )}
        </tbody>
      </table>
    </div>

    <!-- Side Panel -->
    <div id="sidePanel" class="card" style="display:none;position:sticky;top:80px">
      <h3 id="panelTitle" style="margin:0 0 16px">Nuevo Vendedor</h3>
      <form method="POST" id="vendedorForm">
        <input type="hidden" name="action" id="formAction" value="create" />
        <input type="hidden" name="id" id="formId" value="0" />

        <div class="form-group">
          <label>Nombre *</label>
          <input type="text" name="nombre" id="formNombre" class="form-control" required />
        </div>
        <div class="form-group">
          <label>Email</label>
          <input type="email" name="email" id="formEmail" class="form-control" />
        </div>
        <div class="form-group">
          <label>Teléfono</label>
          <input type="text" name="telefono" id="formTelefono" class="form-control" />
        </div>
        <div class="form-group" id="activoGroup" style="display:none">
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
            <input type="checkbox" name="activo" id="formActivo" value="true" checked style="width:16px;height:16px" />
            Activo
          </label>
        </div>

        <div style="display:flex;gap:8px;margin-top:16px">
          <button type="button" class="btn btn-secondary" onclick="closePanel()" style="flex:1">Cancelar</button>
          <button type="submit" class="btn btn-primary" style="flex:1">Guardar</button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script is:inline>
  function openPanel() {
    document.getElementById('panelTitle').textContent = 'Nuevo Vendedor';
    document.getElementById('formAction').value = 'create';
    document.getElementById('formId').value = '0';
    document.getElementById('formNombre').value = '';
    document.getElementById('formEmail').value = '';
    document.getElementById('formTelefono').value = '';
    document.getElementById('activoGroup').style.display = 'none';
    document.getElementById('sidePanel').style.display = 'block';
  }
  function openEdit(id, nombre, email, telefono, activo) {
    document.getElementById('panelTitle').textContent = 'Editar Vendedor';
    document.getElementById('formAction').value = 'update';
    document.getElementById('formId').value = id;
    document.getElementById('formNombre').value = nombre;
    document.getElementById('formEmail').value = email;
    document.getElementById('formTelefono').value = telefono;
    document.getElementById('formActivo').checked = activo;
    document.getElementById('activoGroup').style.display = 'block';
    document.getElementById('sidePanel').style.display = 'block';
  }
  function closePanel() {
    document.getElementById('sidePanel').style.display = 'none';
  }
</script>
