---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { store } from '../../lib/store';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action')?.toString();
  if (action === 'delete') {
    const id = form.get('id')?.toString() ?? '';
    await store.deleteCliente(id);
  }
  return Astro.redirect('/clientes');
}

const clientes = await store.getClientes();
---

<AdminLayout title="Clientes">
  <div class="page-header">
    <h1>Clientes</h1>
    <a href="/clientes/nuevo" class="btn btn-primary">
      <span class="material-icons-round">add</span> Nuevo Cliente
    </a>
  </div>

  <div class="card">
    <table data-searchable>
      <thead>
        <tr>
          <th>Nombre / Razón Social</th>
          <th>Tipo</th>
          <th>RUC</th>
          <th>Teléfono</th>
          <th>Crédito</th>
          <th>Vendedor</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        {clientes.map(c => (
          <tr style="cursor:pointer" onclick={`window.location='/clientes/${c.id}/editar'`}>
            <td>
              <div>{c.nombre}</div>
              {c.nombreComercial && <div style="font-size:12px;color:var(--text-muted)">{c.nombreComercial}</div>}
            </td>
            <td>{c.tipoCliente || '—'}</td>
            <td>{c.ruc ? `${c.ruc}${c.digitoVerificador ? '-' + c.digitoVerificador : ''}` : '—'}</td>
            <td>{c.telefono || '—'}</td>
            <td>
              {c.permiteCredito
                ? <span class="badge badge-success">Sí</span>
                : <span class="badge badge-secondary">No</span>}
            </td>
            <td>{c.vendedor || '—'}</td>
            <td onclick="event.stopPropagation()">
              <div style="display:flex;gap:4px;">
                <a href={`/clientes/${c.id}/editar`} class="btn btn-primary btn-sm">
                  <span class="material-icons-round" style="font-size:16px">edit</span>
                </a>
                <form method="POST" style="display:inline" onsubmit="return confirm('¿Eliminar este cliente?')">
                  <input type="hidden" name="_action" value="delete" />
                  <input type="hidden" name="id" value={c.id} />
                  <button type="submit" class="btn btn-danger btn-sm">
                    <span class="material-icons-round" style="font-size:16px">delete</span>
                  </button>
                </form>
              </div>
            </td>
          </tr>
        ))}
        {clientes.length === 0 && (
          <tr><td colspan="7" style="text-align:center;color:var(--text-muted)">No hay clientes registrados.</td></tr>
        )}
      </tbody>
    </table>
  </div>
</AdminLayout>
