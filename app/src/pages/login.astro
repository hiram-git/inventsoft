---
import { login, selectEmpresa, logout, getSession } from '../lib/auth';
import { authDb } from '../db';
import { eq } from 'drizzle-orm';
import { usuariosGlobal, usuarioEmpresas, empresasRegistry } from '../db/auth-schema';
import bcrypt from 'bcryptjs';
import '../styles/global.css';

// Si hay cookies de sesión, verificar que sigan siendo válidas antes de redirigir
const existingUserId  = Astro.cookies.get('session_user_id')?.value;
const existingEmpresa = Astro.cookies.get('session_empresa')?.value;
if (existingUserId && existingEmpresa) {
  try {
    const session = await getSession(Astro.cookies);
    if (session) return Astro.redirect('/dashboard');
  } catch { /* sesión inválida */ }
  // Cookies obsoletas — limpiar para evitar bucle
  logout(Astro.cookies);
}

// ── Tipos de error y sus mensajes ─────────────────────────────────────────
const ERROR_MESSAGES: Record<string, { msg: string; icon: string }> = {
  credentials:     { msg: 'Credenciales inválidas. Verifique su correo y contraseña.',        icon: 'lock'           },
  inactive:        { msg: 'Su cuenta está desactivada. Contacte al administrador.',           icon: 'person_off'     },
  session_expired: { msg: 'Su sesión ha expirado. Por favor inicie sesión nuevamente.',       icon: 'timer_off'      },
  unauthorized:    { msg: 'Acceso denegado. No tiene permisos para esa sección.',             icon: 'block'          },
  invalid_token:   { msg: 'Token de sesión inválido. Por favor inicie sesión nuevamente.',    icon: 'key'            },
  invalid_license: { msg: 'Licencia inválida o expirada. Contacte al administrador.',        icon: 'verified_user'  },
  system_error:    { msg: 'Error del sistema. Por favor intente nuevamente más tarde.',       icon: 'error'          },
};

let errorType = '';
let errorMsg  = '';

// Errores desde query param (ej: redirect desde middleware → ?error=session_expired)
const urlError = Astro.url.searchParams.get('error') ?? '';
if (urlError && ERROR_MESSAGES[urlError]) {
  errorType = urlError;
  errorMsg  = ERROR_MESSAGES[urlError].msg;
}

// Errores desde POST (credenciales)
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const email    = formData.get('email')?.toString().toLowerCase().trim() ?? '';
    const password = formData.get('password')?.toString() ?? '';

    // Authenticate against central auth DB
    const globalRows = await authDb
      .select()
      .from(usuariosGlobal)
      .where(eq(usuariosGlobal.email, email))
      .limit(1);

    const globalUser    = globalRows[0] ?? null;
    const passwordValid = globalUser ? await bcrypt.compare(password, globalUser.passwordHash) : false;

    if (globalUser && passwordValid) {
      // Get user's companies
      const empresaRows = await authDb
        .select({ slug: empresasRegistry.slug, nombre: empresasRegistry.nombre })
        .from(usuarioEmpresas)
        .innerJoin(empresasRegistry, eq(usuarioEmpresas.empresaSlug, empresasRegistry.slug))
        .where(eq(usuarioEmpresas.globalUserId, globalUser.id));

      login(Astro.cookies, String(globalUser.id));

      if (empresaRows.length === 1) {
        selectEmpresa(Astro.cookies, empresaRows[0].slug);
        return Astro.redirect('/dashboard');
      } else if (empresaRows.length > 1) {
        return Astro.redirect('/select-company');
      } else {
        // Single-tenant fallback: auto-select default slug
        const defaultSlug = import.meta.env.DEFAULT_COMPANY_SLUG ?? 'public';
        selectEmpresa(Astro.cookies, defaultSlug);
        return Astro.redirect('/dashboard');
      }
    } else {
      errorType = 'credentials';
    }
    errorMsg = ERROR_MESSAGES[errorType].msg;
  } catch {
    errorType = 'system_error';
    errorMsg  = ERROR_MESSAGES.system_error.msg;
  }
}

const errorIcon = errorType ? ERROR_MESSAGES[errorType].icon : '';
---

<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login - Admin Portal</title>
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet" />
</head>
<body>
  <!-- Floating background particles -->
  <canvas id="bg-canvas" style="position:fixed;inset:0;pointer-events:none;z-index:0"></canvas>

  <div class="login-container" style="position:relative;z-index:1">
    <div class="login-card" id="loginCard">
      <div class="login-header">
        <div class="login-logo">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2L2 7l10 5 10-5-10-5z"/>
            <path d="M2 17l10 5 10-5"/>
            <path d="M2 12l10 5 10-5"/>
          </svg>
        </div>
        <h1>Admin Portal</h1>
        <p>Ingrese sus credenciales para acceder</p>
      </div>

      {errorMsg && (
        <div
          id="errorCallout"
          class="error-callout"
          data-error-type={errorType}
        >
          <span class="material-icons-round error-callout-icon">{errorIcon}</span>
          <span class="error-callout-msg">{errorMsg}</span>
        </div>
      )}

      <form method="POST">
        <div class="form-group">
          <label for="email">Correo electrónico</label>
          <input type="email" id="email" name="email" class="form-control" placeholder="correo@ejemplo.com" required />
        </div>

        <div class="form-group">
          <label for="password">Contraseña</label>
          <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required />
        </div>

        <button type="submit" class="btn btn-primary login-btn" id="loginBtn">
          <span class="material-icons-round" style="font-size:18px">login</span>
          Iniciar Sesión
        </button>
      </form>

      <div class="login-footer">
        <p>Demo: admin@portal.com / admin123</p>
      </div>
    </div>
  </div>
</body>
</html>

<style>
  .login-container {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1e3a5f 0%, #2563eb 100%);
    padding: 20px;
  }

  .login-card {
    background: white;
    border-radius: 16px;
    padding: 40px;
    width: 100%;
    max-width: 420px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.2);
  }

  .login-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .login-logo {
    width: 64px;
    height: 64px;
    background: var(--primary-light);
    color: var(--primary);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
  }

  .login-header h1 {
    font-size: 1.5rem;
    margin-bottom: 4px;
  }

  .login-header p {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  /* ── Error callout ── */
  .error-callout {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: #fef2f2;
    border: 1px solid #fca5a5;
    border-left: 4px solid var(--danger);
    border-radius: 8px;
    padding: 12px 14px;
    margin-bottom: 20px;
    color: #991b1b;
    font-size: 0.875rem;
    line-height: 1.5;
    /* empieza invisible; GSAP lo anima */
    opacity: 0;
  }

  .error-callout-icon {
    font-size: 18px !important;
    color: var(--danger);
    flex-shrink: 0;
    margin-top: 1px;
  }

  /* Colores alternativos según tipo */
  .error-callout[data-error-type="session_expired"],
  .error-callout[data-error-type="unauthorized"],
  .error-callout[data-error-type="invalid_token"] {
    background: #fff7ed;
    border-color: #fdba74;
    border-left-color: #f97316;
    color: #9a3412;
  }
  .error-callout[data-error-type="session_expired"] .error-callout-icon,
  .error-callout[data-error-type="unauthorized"] .error-callout-icon,
  .error-callout[data-error-type="invalid_token"] .error-callout-icon {
    color: #f97316;
  }

  .error-callout[data-error-type="system_error"] {
    background: #faf5ff;
    border-color: #d8b4fe;
    border-left-color: #9333ea;
    color: #581c87;
  }
  .error-callout[data-error-type="system_error"] .error-callout-icon {
    color: #9333ea;
  }

  .login-btn {
    width: 100%;
    padding: 12px;
    font-size: 1rem;
    justify-content: center;
    margin-top: 8px;
  }

  .login-footer {
    text-align: center;
    margin-top: 24px;
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  @keyframes ui-spin { to { transform: rotate(360deg); } }
  .ui-spinner { animation: ui-spin 0.8s linear infinite; font-size: 16px !important; }
</style>

<script>
  import { gsap } from 'gsap';

  // ── Background particles ──────────────────────────────────────
  const canvas = document.getElementById('bg-canvas') as HTMLCanvasElement;
  const ctx    = canvas.getContext('2d')!;
  const W = () => canvas.width  = window.innerWidth;
  const H = () => canvas.height = window.innerHeight;
  W(); H();
  window.addEventListener('resize', () => { W(); H(); });

  interface Particle { x: number; y: number; r: number; alpha: number; vx: number; vy: number; }
  const particles: Particle[] = Array.from({ length: 38 }, () => ({
    x: Math.random() * window.innerWidth,
    y: Math.random() * window.innerHeight,
    r: Math.random() * 3 + 1,
    alpha: Math.random() * 0.4 + 0.05,
    vx: (Math.random() - 0.5) * 0.35,
    vy: (Math.random() - 0.5) * 0.35,
  }));

  function drawParticles() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    particles.forEach(p => {
      p.x += p.vx; p.y += p.vy;
      if (p.x < 0) p.x = canvas.width;
      if (p.x > canvas.width) p.x = 0;
      if (p.y < 0) p.y = canvas.height;
      if (p.y > canvas.height) p.y = 0;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(255,255,255,${p.alpha})`;
      ctx.fill();
    });
    requestAnimationFrame(drawParticles);
  }
  drawParticles();

  // ── Elementos ─────────────────────────────────────────────────
  const card         = document.getElementById('loginCard')!;
  const logo         = document.querySelector<HTMLElement>('.login-logo')!;
  const inputs       = document.querySelectorAll<HTMLElement>('.form-group');
  const btn          = document.getElementById('loginBtn')!;
  const h1           = document.querySelector<HTMLElement>('.login-header h1')!;
  const subtitle     = document.querySelector<HTMLElement>('.login-header p')!;
  const errorCallout = document.getElementById('errorCallout') as HTMLElement | null;

  // Estado inicial explícito de cada elemento — evita que gsap.from()
  // capture opacity:0 heredada del padre (animaría 0→0 quedando invisible)
  gsap.set(card,    { opacity: 0, y: 48, scale: 0.94 });
  gsap.set(logo,    { scale: 0, rotation: -180 });
  gsap.set(h1,      { opacity: 0, y: 8 });
  gsap.set(subtitle,{ opacity: 0, y: 6 });
  gsap.set(inputs,  { opacity: 0, x: -18 });
  gsap.set(btn,     { opacity: 0, y: 10 });

  // ── Timeline principal: entrada del card ───────────────────────
  const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

  tl.to(card,    { opacity: 1, y: 0, scale: 1, duration: 0.6 })
    .to(logo,    { scale: 1, rotation: 0, duration: 0.5, ease: 'back.out(1.8)' }, '-=0.25')
    .to(h1,      { opacity: 1, y: 0, duration: 0.3 }, '-=0.1')
    .to(subtitle,{ opacity: 1, y: 0, duration: 0.3 }, '-=0.2')
    .to(inputs,  { opacity: 1, x: 0, duration: 0.3, stagger: 0.1 }, '-=0.15')
    .to(btn,     { opacity: 1, y: 0, duration: 0.3 }, '-=0.05');

  // ── Animación de error: fade-in + shake exagerado ──────────────
  // Se ejecuta simultáneamente con la entrada del card (t=0 del timeline)
  if (errorCallout) {
    // Bloque 1 (t=0): fade-in del callout, simultáneo con la entrada del card
    tl.to(errorCallout, {
      opacity: 1,
      duration: 0.4,
      ease: 'power2.out',
    }, 0);

    // Bloque 2 (t=0.4): shake exagerado después de que el callout ya es visible
    tl.to(errorCallout, {
      keyframes: [
        { x: -12, duration: 0.05 },
        { x:  12, duration: 0.05 },
        { x: -10, duration: 0.05 },
        { x:  10, duration: 0.05 },
        { x:  -8, duration: 0.05 },
        { x:   8, duration: 0.05 },
        { x:  -5, duration: 0.05 },
        { x:   5, duration: 0.05 },
        { x:   0, duration: 0.10 },
      ],
      ease: 'power2.inOut',
    }, 0.4);
  }

  // ── Input focus micro-animation ────────────────────────────────
  document.querySelectorAll<HTMLElement>('.form-control').forEach(el => {
    el.addEventListener('focus', () => gsap.to(el, { scale: 1.015, duration: 0.2 }));
    el.addEventListener('blur',  () => gsap.to(el, { scale: 1,     duration: 0.2 }));
  });

  // ── Submit: estado de carga ────────────────────────────────────
  document.querySelector('form')!.addEventListener('submit', () => {
    btn.innerHTML = '<span class="material-icons-round ui-spinner">refresh</span> Verificando…';
    (btn as HTMLButtonElement).disabled = true;
    gsap.to(btn, { scale: 0.97, duration: 0.1, yoyo: true, repeat: 1 });
  });
</script>
