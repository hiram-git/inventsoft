---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { store } from '../../lib/store';

const almacenId = Astro.url.searchParams.get('almacen') ?? '';
const productoId = Astro.url.searchParams.get('producto') ?? '';

const [almacenes, productos, movimientos] = await Promise.all([
  store.getAlmacenes(),
  store.getProductos(),
  store.getKardex({
    almacenId: almacenId || undefined,
    productoId: productoId || undefined,
  }),
]);

const tipoBadge: Record<string, string> = {
  entrada: 'badge-success',
  salida: 'badge-danger',
  reserva: 'badge-warning',
  liberacion: 'badge-secondary',
};

const tipoLabel: Record<string, string> = {
  entrada: 'Entrada',
  salida: 'Salida',
  reserva: 'Reserva',
  liberacion: 'Liberación',
};
---

<AdminLayout title="Kardex">
  <div class="page-header">
    <h1>Kardex de Inventario</h1>
  </div>

  <!-- Filters -->
  <div class="card" style="margin-bottom:16px;padding:16px">
    <form method="GET" style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap">
      <div class="form-group" style="margin-bottom:0;flex:1;min-width:180px">
        <label>Almacén</label>
        <select name="almacen" class="form-control">
          <option value="">Todos</option>
          {almacenes.map(a => (
            <option value={a.id} selected={a.id === almacenId}>{a.nombre}</option>
          ))}
        </select>
      </div>
      <div class="form-group" style="margin-bottom:0;flex:1;min-width:180px">
        <label>Producto</label>
        <select name="producto" class="form-control">
          <option value="">Todos</option>
          {productos.map(p => (
            <option value={p.id} selected={p.id === productoId}>{p.nombre}</option>
          ))}
        </select>
      </div>
      <button type="submit" class="btn btn-primary">
        <span class="material-icons-round" style="font-size:16px">search</span> Filtrar
      </button>
      {(almacenId || productoId) && (
        <a href="/kardex" class="btn btn-secondary">
          <span class="material-icons-round" style="font-size:16px">clear</span> Limpiar
        </a>
      )}
    </form>
  </div>

  <div class="card">
    <table data-searchable>
      <thead>
        <tr>
          <th>Fecha</th>
          <th>Almacén</th>
          <th>Producto</th>
          <th>Tipo</th>
          <th>Cantidad</th>
          <th>Stock Ant.</th>
          <th>Stock Nuevo</th>
          <th>Referencia</th>
          <th>Notas</th>
        </tr>
      </thead>
      <tbody>
        {movimientos.map(m => (
          <tr>
            <td style="white-space:nowrap">{m.fecha}</td>
            <td>{m.almacenNombre}</td>
            <td><strong>{m.productoNombre}</strong></td>
            <td>
              <span class:list={['badge', tipoBadge[m.tipo] ?? 'badge-secondary']}>
                {tipoLabel[m.tipo] ?? m.tipo}
              </span>
            </td>
            <td>
              <span class:list={[
                m.tipo === 'entrada' || m.tipo === 'liberacion' ? 'text-success' : 'text-danger'
              ]}>
                {m.tipo === 'entrada' || m.tipo === 'liberacion' ? '+' : '-'}{m.cantidad}
              </span>
            </td>
            <td style="color:var(--text-muted)">{m.stockAnterior}</td>
            <td><strong>{m.stockNuevo}</strong></td>
            <td>
              {m.referenciaNumero
                ? <code style="background:var(--bg);padding:2px 6px;border-radius:4px;font-size:0.8rem">{m.referenciaNumero}</code>
                : '—'
              }
            </td>
            <td style="font-size:0.85rem;color:var(--text-muted)">{m.notas || '—'}</td>
          </tr>
        ))}
        {movimientos.length === 0 && (
          <tr><td colspan="9" style="text-align:center;color:var(--text-muted)">No hay movimientos registrados.</td></tr>
        )}
      </tbody>
    </table>
  </div>
</AdminLayout>

<style>
  .text-success { color: var(--success); font-weight: 600; }
  .text-danger { color: var(--danger); font-weight: 600; }
  .badge-secondary { background: var(--bg); color: var(--text-muted); }
</style>
