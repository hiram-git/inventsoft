---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { store } from '../../lib/store';

const notas = await store.getNotasCredito();
---

<AdminLayout title="Notas de Crédito">
  <div class="page-header">
    <h1>Notas de Crédito</h1>
  </div>

  <div class="card">
    <table data-searchable>
      <thead>
        <tr>
          <th>Número</th>
          <th>Fecha</th>
          <th>Factura origen</th>
          <th>Cliente</th>
          <th>Items</th>
          <th>Total</th>
          <th>Motivo</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        {notas.map(n => (
          <tr>
            <td><strong>{n.numero}</strong></td>
            <td>{n.fecha}</td>
            <td>
              <a href={`/facturas/${n.facturaId}`} style="color:var(--primary)">
                {n.facturaNumero}
              </a>
            </td>
            <td>{n.clienteNombre}</td>
            <td>{n.items.length} item(s)</td>
            <td><strong>${n.total.toLocaleString('es-MX', { minimumFractionDigits: 2 })}</strong></td>
            <td style="max-width:200px;font-size:0.875rem;color:var(--text-muted)">{n.motivo || '—'}</td>
            <td>
              <a href={`/notas-credito/${n.id}`} class="btn btn-primary btn-sm" title="Ver detalle">
                <span class="material-icons-round" style="font-size:16px">visibility</span>
              </a>
            </td>
          </tr>
        ))}
        {notas.length === 0 && (
          <tr><td colspan="8" style="text-align:center;color:var(--text-muted)">No hay notas de crédito registradas.</td></tr>
        )}
      </tbody>
    </table>
  </div>
</AdminLayout>
