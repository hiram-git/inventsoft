---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { store } from '../../lib/store';

const cxc = await store.getCuentasPorCobrar();
const today = new Date().toISOString().split('T')[0];

// Summary totals
const totalCxC = cxc.reduce((s, f) => s + f.saldo, 0);
const totalVencidas = cxc.filter(f => f.diasVencido > 0).reduce((s, f) => s + f.saldo, 0);
const totalCorrientes = totalCxC - totalVencidas;
const countVencidas = cxc.filter(f => f.diasVencido > 0).length;

// Aging buckets (only vencidas)
const bucket30 = cxc.filter(f => f.diasVencido > 0 && f.diasVencido <= 30).reduce((s, f) => s + f.saldo, 0);
const bucket60 = cxc.filter(f => f.diasVencido > 30 && f.diasVencido <= 60).reduce((s, f) => s + f.saldo, 0);
const bucket90 = cxc.filter(f => f.diasVencido > 60 && f.diasVencido <= 90).reduce((s, f) => s + f.saldo, 0);
const bucket90plus = cxc.filter(f => f.diasVencido > 90).reduce((s, f) => s + f.saldo, 0);

// Group by client
const byCliente = new Map<string, { nombre: string; saldo: number; count: number; maxDias: number }>();
for (const f of cxc) {
  const key = f.clienteId;
  const prev = byCliente.get(key);
  if (prev) {
    prev.saldo += f.saldo;
    prev.count += 1;
    prev.maxDias = Math.max(prev.maxDias, f.diasVencido);
  } else {
    byCliente.set(key, { nombre: f.clienteNombre, saldo: f.saldo, count: 1, maxDias: f.diasVencido });
  }
}
const clientesSorted = [...byCliente.entries()].sort((a, b) => b[1].saldo - a[1].saldo);
---

<AdminLayout title="Cuentas por Cobrar">
  <div class="page-header">
    <div>
      <h1>Cuentas por Cobrar</h1>
      <p class="text-muted">Seguimiento de facturas pendientes y gestión de cobros</p>
    </div>
    <a href="/cobros/nuevo" class="btn btn-primary">
      <span class="material-icons-round">payments</span>
      Registrar Cobro
    </a>
  </div>

  <!-- Summary Cards -->
  <div class="summary-grid">
    <div class="summary-card">
      <div class="summary-icon blue"><span class="material-icons-round">account_balance_wallet</span></div>
      <div>
        <div class="summary-label">Total por Cobrar</div>
        <div class="summary-value">${totalCxC.toFixed(2)}</div>
        <div class="summary-sub">{cxc.length} factura{cxc.length !== 1 ? 's' : ''}</div>
      </div>
    </div>
    <div class="summary-card">
      <div class="summary-icon green"><span class="material-icons-round">schedule</span></div>
      <div>
        <div class="summary-label">Corrientes (al día)</div>
        <div class="summary-value">${totalCorrientes.toFixed(2)}</div>
        <div class="summary-sub">{cxc.filter(f => f.diasVencido === 0).length} factura{cxc.filter(f => f.diasVencido === 0).length !== 1 ? 's' : ''}</div>
      </div>
    </div>
    <div class="summary-card">
      <div class="summary-icon red"><span class="material-icons-round">warning</span></div>
      <div>
        <div class="summary-label">Vencidas</div>
        <div class="summary-value">${totalVencidas.toFixed(2)}</div>
        <div class="summary-sub">{countVencidas} factura{countVencidas !== 1 ? 's' : ''}</div>
      </div>
    </div>
    <div class="summary-card">
      <div class="summary-icon purple"><span class="material-icons-round">people</span></div>
      <div>
        <div class="summary-label">Clientes con Saldo</div>
        <div class="summary-value">{byCliente.size}</div>
        <div class="summary-sub">con facturas pendientes</div>
      </div>
    </div>
  </div>

  <!-- Aging Analysis -->
  {totalVencidas > 0 && (
    <div class="card" style="margin-bottom: 16px;">
      <h2>Análisis de Antigüedad (Cartera Vencida)</h2>
      <div class="aging-grid">
        <div class="aging-bucket">
          <span class="aging-label">1 - 30 días</span>
          <span class="aging-value yellow">${bucket30.toFixed(2)}</span>
        </div>
        <div class="aging-bucket">
          <span class="aging-label">31 - 60 días</span>
          <span class="aging-value orange">${bucket60.toFixed(2)}</span>
        </div>
        <div class="aging-bucket">
          <span class="aging-label">61 - 90 días</span>
          <span class="aging-value red">${bucket90.toFixed(2)}</span>
        </div>
        <div class="aging-bucket">
          <span class="aging-label">+ 90 días</span>
          <span class="aging-value dark-red">${bucket90plus.toFixed(2)}</span>
        </div>
      </div>
    </div>
  )}

  <div class="two-col">
    <!-- Facturas Pendientes -->
    <div class="card">
      <h2>Facturas Pendientes</h2>
      {cxc.length === 0 ? (
        <div class="empty-state">
          <span class="material-icons-round">check_circle</span>
          <p>No hay facturas pendientes de cobro</p>
        </div>
      ) : (
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Factura</th>
                <th>Cliente</th>
                <th>Vencimiento</th>
                <th>Saldo</th>
                <th>Estado</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {cxc.map(f => (
                <tr class:list={[{ 'row-vencida': f.diasVencido > 0 }]}>
                  <td>
                    <a href={`/facturas/${f.id}`} class="link">{f.numero}</a>
                  </td>
                  <td>{f.clienteNombre}</td>
                  <td>
                    {f.fechaVencimiento ? (
                      <span class:list={[f.diasVencido > 0 ? 'text-danger' : '']}>
                        {f.fechaVencimiento}
                        {f.diasVencido > 0 && <span class="dias-badge">+{f.diasVencido}d</span>}
                      </span>
                    ) : <span class="text-muted">—</span>}
                  </td>
                  <td><strong>${f.saldo.toFixed(2)}</strong></td>
                  <td>
                    <span class:list={['badge',
                      f.estado === 'parcial' ? 'badge-warning' :
                      f.estado === 'vencida' ? 'badge-danger' : 'badge-info'
                    ]}>
                      {f.estado.charAt(0).toUpperCase() + f.estado.slice(1)}
                    </span>
                  </td>
                  <td>
                    <a href={`/cobros/nuevo?factura=${f.id}`} class="btn btn-sm btn-primary">Cobrar</a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>

    <!-- Por Cliente -->
    <div class="card">
      <h2>Resumen por Cliente</h2>
      {clientesSorted.length === 0 ? (
        <div class="empty-state">
          <p>Sin datos</p>
        </div>
      ) : (
        <div class="cliente-list">
          {clientesSorted.map(([clienteId, info]) => (
            <div class="cliente-row">
              <div class="cliente-avatar">{info.nombre.charAt(0).toUpperCase()}</div>
              <div class="cliente-info">
                <span class="cliente-nombre">{info.nombre}</span>
                <span class="cliente-meta">{info.count} factura{info.count !== 1 ? 's' : ''} pendiente{info.count !== 1 ? 's' : ''}</span>
              </div>
              <div class="cliente-saldo">
                <span class="saldo-value">${info.saldo.toFixed(2)}</span>
                {info.maxDias > 0 && <span class="vencida-chip">Vencida</span>}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</AdminLayout>

<style>
  .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
  h1 { font-size: 1.5rem; font-weight: 700; margin: 0; }
  h2 { font-size: 1rem; font-weight: 600; margin: 0 0 16px; }
  .text-muted { color: var(--text-muted); font-size: 0.875rem; margin: 4px 0 0; }
  .text-danger { color: var(--danger); }

  .summary-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 20px; }
  .summary-card { background: white; border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; display: flex; align-items: center; gap: 16px; }
  .summary-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .summary-icon.blue { background: #dbeafe; color: #2563eb; }
  .summary-icon.green { background: #dcfce7; color: #16a34a; }
  .summary-icon.red { background: #fee2e2; color: #dc2626; }
  .summary-icon.purple { background: #f3e8ff; color: #9333ea; }
  .summary-icon .material-icons-round { font-size: 24px; }
  .summary-label { font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .summary-value { font-size: 1.4rem; font-weight: 700; line-height: 1.2; }
  .summary-sub { font-size: 0.75rem; color: var(--text-muted); }

  .aging-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .aging-bucket { background: #f8fafc; border-radius: var(--radius); padding: 16px; text-align: center; }
  .aging-label { display: block; font-size: 0.75rem; color: var(--text-muted); margin-bottom: 8px; }
  .aging-value { font-size: 1.2rem; font-weight: 700; }
  .aging-value.yellow { color: #ca8a04; }
  .aging-value.orange { color: #ea580c; }
  .aging-value.red { color: #dc2626; }
  .aging-value.dark-red { color: #991b1b; }

  .two-col { display: grid; grid-template-columns: 1fr 380px; gap: 16px; }
  .card { background: white; border-radius: var(--radius); border: 1px solid var(--border); padding: 24px; }
  .table-wrapper { overflow-x: auto; margin: 0 -24px; padding: 0 24px; }
  table { width: 100%; border-collapse: collapse; }
  th { background: #f8fafc; padding: 8px 12px; text-align: left; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); border-bottom: 1px solid var(--border); }
  td { padding: 10px 12px; border-bottom: 1px solid var(--border); font-size: 0.875rem; vertical-align: middle; }
  tr:last-child td { border-bottom: none; }
  .row-vencida { background: #fff8f8; }
  .dias-badge { display: inline-block; background: #fee2e2; color: #dc2626; font-size: 0.7rem; padding: 1px 6px; border-radius: 10px; margin-left: 6px; font-weight: 600; }
  .badge { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 0.72rem; font-weight: 600; }
  .badge-success { background: #dcfce7; color: #16a34a; }
  .badge-danger { background: #fee2e2; color: #dc2626; }
  .badge-warning { background: #fef9c3; color: #ca8a04; }
  .badge-info { background: #dbeafe; color: #2563eb; }
  .link { color: var(--primary); text-decoration: none; }
  .link:hover { text-decoration: underline; }
  .btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: var(--radius); font-size: 0.875rem; font-weight: 500; border: none; cursor: pointer; text-decoration: none; transition: all 0.2s; }
  .btn-primary { background: var(--primary); color: white; }
  .btn-primary:hover { background: var(--primary-dark); }
  .btn-sm { padding: 4px 10px; font-size: 0.8rem; }

  .cliente-list { display: flex; flex-direction: column; gap: 2px; }
  .cliente-row { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--border); }
  .cliente-row:last-child { border-bottom: none; }
  .cliente-avatar { width: 36px; height: 36px; background: #eff6ff; color: #2563eb; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.9rem; flex-shrink: 0; }
  .cliente-info { flex: 1; min-width: 0; }
  .cliente-nombre { display: block; font-weight: 500; font-size: 0.875rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cliente-meta { font-size: 0.75rem; color: var(--text-muted); }
  .cliente-saldo { text-align: right; flex-shrink: 0; }
  .saldo-value { display: block; font-weight: 700; font-size: 0.9rem; }
  .vencida-chip { background: #fee2e2; color: #dc2626; font-size: 0.7rem; padding: 1px 6px; border-radius: 10px; font-weight: 600; }

  .empty-state { text-align: center; padding: 40px 24px; color: var(--text-muted); }
  .empty-state .material-icons-round { font-size: 40px; margin-bottom: 8px; opacity: 0.4; display: block; }

  @media (max-width: 1100px) {
    .summary-grid { grid-template-columns: repeat(2, 1fr); }
    .aging-grid { grid-template-columns: repeat(2, 1fr); }
    .two-col { grid-template-columns: 1fr; }
  }
</style>
